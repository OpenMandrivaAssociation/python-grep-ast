--- a/grep_ast/tsl.py	2025-02-10 22:58:05.000000000 +0100
+++ b/grep_ast/tsl.py	2026-09-12 04:17:51.248779498 +0200
@@ -3,7 +3,38 @@
 
     USING_TSL_PACK = True
 except ImportError:
-    from tree_sitter_languages import get_language, get_parser
+    from tree_sitter import Language, Parser
+
+    # (module, language factory). TypeScript ships language_typescript /
+    # language_tsx instead of language().
+    _LANG_MOD = {
+        "python": ("tree_sitter_python", "language"),
+        "javascript": ("tree_sitter_javascript", "language"),
+        "typescript": ("tree_sitter_typescript", "language_typescript"),
+        "tsx": ("tree_sitter_typescript", "language_tsx"),
+        "rust": ("tree_sitter_rust", "language"),
+        "go": ("tree_sitter_go", "language"),
+        "bash": ("tree_sitter_bash", "language"),
+        "json": ("tree_sitter_json", "language"),
+        "html": ("tree_sitter_html", "language"),
+        "c": ("tree_sitter_c", "language"),
+        "cpp": ("tree_sitter_cpp", "language"),
+        "java": ("tree_sitter_java", "language"),
+        "css": ("tree_sitter_css", "language"),
+        "yaml": ("tree_sitter_yaml", "language"),
+        "markdown": ("tree_sitter_markdown", "language"),
+    }
+
+    def get_language(name):
+        spec = _LANG_MOD.get(name)
+        if not spec:
+            raise LookupError(f"no packaged tree-sitter grammar for {name}")
+        modname, attr = spec
+        mod = __import__(modname, fromlist=[attr])
+        return Language(getattr(mod, attr)())
+
+    def get_parser(name):
+        return Parser(get_language(name))
 
     USING_TSL_PACK = False
 
